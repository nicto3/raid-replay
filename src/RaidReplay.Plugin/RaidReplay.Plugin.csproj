<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build:  dotnet build -c Release -p:EftDir="C:\SPT"   (EftDir = your SPT 4.1 game folder) -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>RaidReplay</AssemblyName>
    <RootNamespace>RaidReplay</RootNamespace>
    <EftDir Condition="'$(EftDir)' == ''">D:\EscapeFromTarkov\EscapeFromTarkov</EftDir>
    <Managed>$(EftDir)\EscapeFromTarkov_Data\Managed</Managed>
    <BepInExCore>$(EftDir)\BepInEx\core</BepInExCore>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.*" Condition="!Exists('$(BepInExCore)\BepInEx.dll')" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" IncludeAssets="compile" Condition="!Exists('$(Managed)\UnityEngine.CoreModule.dll')" />
  </ItemGroup>

  <ItemGroup>
    <!-- the codec/format/library code is compiled straight into the plugin: one DLL to install -->
    <Compile Include="..\RaidReplay.Core\**\*.cs" Exclude="..\RaidReplay.Core\obj\**;..\RaidReplay.Core\bin\**" />
    <Reference Include="Assembly-CSharp" Condition="Exists('$(Managed)\Assembly-CSharp.dll')"><HintPath>$(Managed)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Comfort" Condition="Exists('$(Managed)\Comfort.dll')"><HintPath>$(Managed)\Comfort.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx" Condition="Exists('$(BepInExCore)\BepInEx.dll')"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony" Condition="Exists('$(BepInExCore)\0Harmony.dll')"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule" Condition="Exists('$(Managed)\UnityEngine.CoreModule.dll')"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule" Condition="Exists('$(Managed)\UnityEngine.IMGUIModule.dll')"><HintPath>$(Managed)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule" Condition="Exists('$(Managed)\UnityEngine.TextRenderingModule.dll')"><HintPath>$(Managed)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule" Condition="Exists('$(Managed)\UnityEngine.PhysicsModule.dll')"><HintPath>$(Managed)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule" Condition="Exists('$(Managed)\UnityEngine.InputLegacyModule.dll')"><HintPath>$(Managed)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sirenix.Serialization" Condition="Exists('$(Managed)\Sirenix.Serialization.dll')"><HintPath>$(Managed)\Sirenix.Serialization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine" Condition="Exists('$(Managed)\UnityEngine.dll')"><HintPath>$(Managed)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="Deploy" AfterTargets="Build" Condition="Exists('$(EftDir)\BepInEx\plugins') And '$(SkipDeploy)' != 'true'">
    <Copy SourceFiles="$(OutputPath)RaidReplay.dll" DestinationFolder="$(EftDir)\BepInEx\plugins\RaidReplay" />
  </Target>
</Project>
